<w:WidgetBase x:Class="IdleDash.Widgets.SystemStatsWidget"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:w="clr-namespace:IdleDash.Widgets">
    <Viewbox Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top">
        <StackPanel Width="330">
            <Grid>
                <TextBlock Text="CPU" FontSize="18"/>
                <TextBlock x:Name="CpuText" Text="–" FontSize="18" HorizontalAlignment="Right"
                           Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Grid>
            <ProgressBar x:Name="CpuBar" Style="{StaticResource SlimBar}" Margin="0,10,0,26"/>

            <Grid>
                <TextBlock Text="GPU" FontSize="18"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="GpuTempText" FontSize="18" Margin="0,0,14,0"
                               Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock x:Name="GpuText" Text="–" FontSize="18"
                               Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Grid>
            <ProgressBar x:Name="GpuBar" Style="{StaticResource SlimBar}" Margin="0,10,0,26"/>

            <Grid>
                <TextBlock Text="RAM" FontSize="18"/>
                <TextBlock x:Name="RamText" Text="–" FontSize="18" HorizontalAlignment="Right"
                           Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Grid>
            <ProgressBar x:Name="RamBar" Style="{StaticResource SlimBar}" Margin="0,10,0,0"/>
        </StackPanel>
    </Viewbox>
</w:WidgetBase>
