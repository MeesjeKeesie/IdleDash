<w:WidgetBase x:Class="IdleDash.Widgets.NewsWidget"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:w="clr-namespace:IdleDash.Widgets">
    <Grid ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="SourceText" Text="NOS" FontSize="14" Margin="0,0,0,8"
                   Foreground="{StaticResource TextSecondaryBrush}"/>

        <!-- Koppen; klik er een aan om het artikel te openen -->
        <StackPanel x:Name="HeadlineList" Grid.Row="1" Margin="-8,0,-8,0"/>

        <TextBlock x:Name="MessageText" Grid.Row="1" FontSize="16" TextWrapping="Wrap" Visibility="Collapsed"
                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
    </Grid>
</w:WidgetBase>
