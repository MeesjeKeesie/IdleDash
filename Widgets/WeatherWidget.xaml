<w:WidgetBase x:Class="IdleDash.Widgets.WeatherWidget"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:w="clr-namespace:IdleDash.Widgets">
    <Viewbox Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top">
        <StackPanel Width="380">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="IconText" Text="&#x2601;" FontFamily="{StaticResource SymbolFont}" FontSize="56"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock x:Name="TempText" Text="--°" FontSize="84" FontWeight="Light"
                           Margin="16,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock x:Name="DescText" Text="Weer ophalen…" FontSize="18"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,0,0"/>
            <TextBlock x:Name="DetailText" FontSize="15"
                       Foreground="{DynamicResource TextMutedBrush}" Margin="2,4,0,0"/>

            <!-- Zon en maan -->
            <StackPanel x:Name="SunMoonRow" Orientation="Horizontal" Margin="2,8,0,0" Visibility="Collapsed">
                <TextBlock x:Name="SunText" FontSize="15" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                <ContentControl x:Name="MoonIcon" Width="15" Height="15" Margin="18,0,7,0" VerticalAlignment="Center" Focusable="False"/>
                <TextBlock x:Name="MoonText" FontSize="15" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- De komende drie dagen -->
            <UniformGrid x:Name="ForecastGrid" Columns="3" Rows="1" Margin="2,26,0,0"/>
        </StackPanel>
    </Viewbox>
</w:WidgetBase>
