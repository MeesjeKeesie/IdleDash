<w:WidgetBase x:Class="IdleDash.Widgets.RainWidget"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:w="clr-namespace:IdleDash.Widgets">
    <Viewbox Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top">
        <Grid Width="380" Height="200">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="SummaryText" Text="Buienradar laden…" FontSize="20" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="DetailText" Grid.Row="1" FontSize="13" Margin="0,2,0,0"
                       Foreground="{StaticResource TextMutedBrush}"/>

            <!-- Staafjes: verwachte neerslag per 5 minuten -->
            <Grid Grid.Row="2" Margin="0,14,0,6">
                <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource TrackBrush}"/>
                <UniformGrid x:Name="Bars" Rows="1"/>
            </Grid>

            <Grid Grid.Row="3">
                <TextBlock x:Name="StartTimeText" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock x:Name="MidTimeText" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="EndTimeText" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </Viewbox>
</w:WidgetBase>
