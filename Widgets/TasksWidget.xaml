<w:WidgetBase x:Class="IdleDash.Widgets.TasksWidget"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:w="clr-namespace:IdleDash.Widgets">
    <Grid ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Nieuwe taak typen: Enter = toevoegen, Esc = wissen -->
        <Grid x:Name="NewTaskRow" Margin="0,0,0,14">
            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="14"
                       Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,0"
                       VerticalAlignment="Center" IsHitTestVisible="False"/>
            <TextBlock x:Name="NewTaskPlaceholder" Text="Nieuwe taak…" FontSize="16" Margin="32,0,0,0"
                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <TextBox x:Name="NewTaskBox" Style="{StaticResource InlineTextBox}" Margin="32,0,0,0"
                     KeyDown="NewTaskBox_KeyDown" TextChanged="NewTaskBox_TextChanged"/>
        </Grid>

        <!-- De taken zelf (wordt in de code gevuld) -->
        <StackPanel x:Name="TaskList" Grid.Row="1"/>

        <!-- Melding als Google niet gekoppeld is -->
        <StackPanel x:Name="MessagePanel" Grid.RowSpan="2" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock x:Name="MessageText" FontSize="16" TextWrapping="Wrap" LineHeight="23"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <Button x:Name="MessageButton" Style="{StaticResource PillButton}" Content="Instellingen openen"
                    HorizontalAlignment="Left" Margin="0,14,0,0" Click="MessageButton_Click"/>
        </StackPanel>
    </Grid>
</w:WidgetBase>
