<w:WidgetBase x:Class="IdleDash.Widgets.NowPlayingWidget"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:w="clr-namespace:IdleDash.Widgets">
    <Viewbox Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top">
        <Grid Width="440" Height="150">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Hoesje (afgeronde hoeken via de achtergrond van de Border) -->
            <Border x:Name="Cover" Width="150" Height="150" CornerRadius="12" Background="#14FFFFFF">
                <TextBlock x:Name="CoverPlaceholder" Text="&#x266B;" FontFamily="{StaticResource SymbolFont}"
                           FontSize="44" Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" Margin="22,2,0,0">
                <TextBlock x:Name="TitleText" Text="Er speelt niets" FontSize="21" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ArtistText" FontSize="15" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource TextSecondaryBrush}"/>

                <ProgressBar x:Name="TrackProgress" Style="{StaticResource SlimBar}" Height="4" Margin="0,16,0,0"/>
                <Grid Margin="0,5,0,0">
                    <TextBlock x:Name="PositionText" FontSize="12" Typography.NumeralAlignment="Tabular"
                               Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock x:Name="DurationText" FontSize="12" Typography.NumeralAlignment="Tabular"
                               Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                </Grid>

                <StackPanel x:Name="ButtonRow" Orientation="Horizontal" Margin="-10,4,0,0">
                    <Button x:Name="PrevButton" Style="{StaticResource IconButton}" Content="&#xE892;"
                            ToolTip="Vorige" Click="PrevButton_Click"/>
                    <Button x:Name="PlayPauseButton" Style="{StaticResource IconButton}" Content="&#xE768;"
                            ToolTip="Afspelen of pauzeren" Click="PlayPauseButton_Click"/>
                    <Button x:Name="NextButton" Style="{StaticResource IconButton}" Content="&#xE893;"
                            ToolTip="Volgende" Click="NextButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Viewbox>
</w:WidgetBase>
