<w:WidgetBase x:Class="IdleDash.Widgets.FocusTimerWidget"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:w="clr-namespace:IdleDash.Widgets">
    <Viewbox Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top">
        <Grid Width="280" Height="330">
            <Grid.RowDefinitions>
                <RowDefinition Height="250"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Ring die leegloopt terwijl de tijd verstrijkt -->
            <Grid Width="240" Height="240" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Ellipse Stroke="{DynamicResource TrackBrush}" StrokeThickness="6"/>
                <Path x:Name="ProgressArc" Stroke="{DynamicResource BarBrush}" StrokeThickness="6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="ModeText" Text="Focus" FontSize="16" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="TimeText" Text="25:00" FontSize="56" FontWeight="Light"
                               HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="ResetButton" Style="{StaticResource IconButton}" Content="&#xE72C;"
                        ToolTip="Opnieuw beginnen" Click="ResetButton_Click"/>
                <Button x:Name="StartButton" Style="{StaticResource RoundAccentButton}" Content="&#xE768;"
                        ToolTip="Starten" Margin="16,0" Click="StartButton_Click"/>
                <Button x:Name="SkipButton" Style="{StaticResource IconButton}" Content="&#xE893;"
                        ToolTip="Naar pauze" Click="SkipButton_Click"/>
            </StackPanel>
        </Grid>
    </Viewbox>
</w:WidgetBase>
