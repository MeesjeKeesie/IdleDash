<Window x:Class="IdleDash.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IdleDash"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        Loaded="Window_Loaded"
        MouseMove="Window_MouseMove"
        KeyDown="Window_KeyDown">

    <!-- Achtergrond "Lucht": kleurt langzaam mee met het tijdstip van de dag (andere thema's vervangen dit) -->
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop x:Name="SkyTop" Color="#15233A" Offset="0"/>
            <GradientStop x:Name="SkyBottom" Color="#0C1422" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Grid x:Name="Root" Background="Transparent">

        <!-- Eigen foto als achtergrond, met een donkere laag zodat tekst leesbaar blijft -->
        <Image x:Name="BackgroundImage" Stretch="UniformToFill" Visibility="Collapsed" IsHitTestVisible="False"/>
        <Border x:Name="BackgroundTint" Background="Black" Opacity="0" IsHitTestVisible="False"/>

        <!-- Zachte gloed bovenin, alsof het licht van de lucht komt -->
        <Border x:Name="Glow" IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="0.3,-0.1" GradientOrigin="0.3,-0.1" RadiusX="0.9" RadiusY="0.8">
                    <GradientStop x:Name="GlowStart" Color="#552F5277" Offset="0"/>
                    <GradientStop x:Name="GlowEnd" Color="#002F5277" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <Rectangle x:Name="GridOverlay" Fill="{StaticResource DotGridBrush}"
                   IsHitTestVisible="False" Visibility="Collapsed"/>

        <!-- Hier komen de widgets -->
        <Canvas x:Name="WidgetCanvas" ClipToBounds="True">
            <Canvas.RenderTransform>
                <TranslateTransform x:Name="ShiftTransform"/>
            </Canvas.RenderTransform>
        </Canvas>

        <!-- Nachtmodus: 's avonds een donkere laag over alles (beweeg de muis om even helder te maken) -->
        <Border x:Name="DimOverlay" Background="Black" Opacity="0" IsHitTestVisible="False"/>

        <!-- Melding van het smarthome, bv. de deurbel -->
        <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,32,0,0"
                Padding="22,14" CornerRadius="16" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                Opacity="0" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xEA8F;" FontFamily="{StaticResource IconFont}" FontSize="22"
                           Foreground="{DynamicResource BarBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <StackPanel>
                    <TextBlock x:Name="ToastTitle" FontSize="20"/>
                    <TextBlock x:Name="ToastText" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Knoppen rechtsboven: verschijnen zodra je de muis beweegt -->
        <Border x:Name="Toolbar" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,24,24,0"
                Padding="4" CornerRadius="12" Background="{DynamicResource SubtleBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" Opacity="0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="AddButton" Style="{StaticResource IconButton}" Content="&#xE710;"
                        ToolTip="Widget toevoegen" Click="AddButton_Click" Visibility="Collapsed"/>
                <Button x:Name="EditButton" Style="{StaticResource IconButton}" Content="&#xE70F;"
                        ToolTip="Indeling bewerken" Click="EditButton_Click"/>
                <Button x:Name="DoneButton" Style="{StaticResource IconButton}" Content="&#xE73E;"
                        ToolTip="Klaar met bewerken" Click="DoneButton_Click" Visibility="Collapsed"/>
                <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Content="&#xE713;"
                        ToolTip="Instellingen" Click="SettingsButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Lijstje met widgets om toe te voegen -->
        <Popup x:Name="AddPopup" PlacementTarget="{Binding ElementName=AddButton}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" VerticalOffset="10" PopupAnimation="Fade">
            <Border Width="250" Padding="6" CornerRadius="12" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                    TextElement.FontFamily="{StaticResource UiFont}">
                <StackPanel>
                    <Grid Margin="6,4,6,8">
                        <TextBox x:Name="AddSearchBox" Style="{StaticResource InlineTextBox}"
                                 TextChanged="AddSearchBox_TextChanged" KeyDown="AddSearchBox_KeyDown"/>
                        <TextBlock x:Name="AddSearchHint" Text="Zoek een widget…" IsHitTestVisible="False" VerticalAlignment="Center"
                                   Margin="4,0,0,0" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"/>
                    </Grid>
                    <StackPanel x:Name="AddList"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
